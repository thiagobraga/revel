{
  "name": "revel-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/stamp.mjs && next build --webpack && node scripts/pwa.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "COVERAGE=true npm run build && PLAYWRIGHT_COVERAGE=1 playwright test && node scripts/merge-coverage.mjs",
    "budget": "node scripts/budget.mjs",
    "audit:browser": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-persist-client": "5.104.0",
    "idb": "8.0.3",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "workbox-window": "7.4.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-istanbul": "8.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  }
}
