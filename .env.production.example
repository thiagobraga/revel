COMPOSE_PROJECT_NAME=revel-production
PROD_DOMAIN=revel.thiagobraga.dev
GHCR_OWNER=thiagobraga
# Set to the full commit SHA published by the Deploy workflow.
IMAGE_TAG=
# Set only after verifying the sending domain in Resend.
EMAIL_FROM=
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_HOURS=12
DATABASE_URL_FILE=./secrets/database_url
REDIS_URL_FILE=./secrets/redis_url
CSRF_SECRET_FILE=./secrets/csrf_secret
RESEND_API_KEY_FILE=./secrets/resend_api_key
POSTGRES_USER_FILE=./secrets/postgres_user
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRES_DB_FILE=./secrets/postgres_db
REDIS_PASSWORD_FILE=./secrets/redis_password
BACKUP_DIR=./backups
SPOTIFY_URL=
BANDCAMP_URL=
YOUTUBE_URL=
INSTAGRAM_URL=
CONTACT_URL=
PETROLEO_URL=
