{
  "name": "revel-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "provision-user": "tsx src/db/provisionUser.ts",
    "cleanup": "tsx src/db/cleanup.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "redis": "6.3.0",
    "resend": "6.32.0",
    "sanitize-html": "2.18.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "@types/zxcvbn": "4.4.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
